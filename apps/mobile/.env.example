# Public configuration bundled into the app. Never put server credentials here.
# iOS simulator: localhost; Android emulator: 10.0.2.2; device: your LAN hostname/IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Later: optional public crash-reporting endpoint (not a Sentry auth token).
EXPO_PUBLIC_SENTRY_DSN=

# Public UUID of the actual EAS project. Not needed for the Expo Go inbox.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local ignored file path, or an EAS file environment variable. Never a service-account key.
# GOOGLE_SERVICES_JSON=.local/google-services.json
