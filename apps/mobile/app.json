{
  "expo": {
    "name": "Portl",
    "slug": "portl",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/portl-icon-v1.png",
    "scheme": "portl",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/portl-icon-v1.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173D32",
        "foregroundImage": "./assets/images/portl-adaptive-foreground-v1.png",
        "monochromeImage": "./assets/images/portl-adaptive-monochrome-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
