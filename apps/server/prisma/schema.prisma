generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["portl_auth", "portl_registry", "portl_gate"]
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  twoFactorEnabled Boolean @default(false)
  twoFactor TwoFactor?
  totpUses AdminTotpUse[]
  memberships Membership[]
  occupancies Occupancy[]
  applications ResidentApplication[]
  sessions      Session[]
  accounts      Account[]

  @@schema("portl_auth")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  assurance AdminAssurance?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("portl_auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@schema("portl_auth")
}

model Verification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@schema("portl_auth")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@schema("portl_auth")
}

model OtpThrottle {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@schema("portl_auth")
}

model TwoFactor {
  id String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  @@schema("portl_auth")
}
model AdminAssurance {
  sessionId String @id
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@schema("portl_auth")
}
model AdminTotpUse {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  digest String
  expiresAt DateTime
  @@id([userId, digest])
  @@schema("portl_auth")
}
enum SocietyRole {
  RESIDENT
  GUARD
  ADMIN
  @@schema("portl_registry")
}
enum ResidentRelationship {
  OWNER
  TENANT
  @@schema("portl_registry")
}
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  @@schema("portl_registry")
}
model Society {
  id String @id @default(uuid())
  name String
  joinCodeHash String @unique
  isDemo Boolean @default(true)
  archived Boolean @default(false)
  towers Tower[]
  flats Flat[]
  memberships Membership[]
  occupancies Occupancy[]
  invitations Invitation[]
  applications ResidentApplication[]
  audits RegistryAudit[]
  gates Gate[]
  visitorRequests VisitorRequest[]
  @@schema("portl_registry")
}
model Tower {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  name String
  flats Flat[]
  @@unique([societyId, id])
  @@unique([societyId, name])
  @@schema("portl_registry")
}
model Flat {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  towerId String
  tower Tower @relation(fields: [societyId, towerId], references: [societyId, id])
  label String
  archived Boolean @default(false)
  occupancies Occupancy[]
  invitations Invitation[]
  applications ResidentApplication[]
  visitorRequests VisitorRequest[]
  @@unique([societyId, id])
  @@unique([societyId, towerId, label])
  @@schema("portl_registry")
}
model Membership {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SocietyRole
  active Boolean @default(true)
  @@unique([societyId, userId, role])
  @@index([userId, active])
  @@schema("portl_registry")
}
model Occupancy {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship ResidentRelationship
  startedAt DateTime @default(now())
  endedAt DateTime?
  @@unique([societyId, id])
  @@unique([societyId, flatId, userId])
  @@index([userId, endedAt])
  @@schema("portl_registry")
}
model Invitation {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  email String
  relationship ResidentRelationship
  tokenHash String @unique
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  acceptedBy String?
  revokedAt DateTime?
  @@index([societyId, createdAt, id])
  @@schema("portl_registry")
}
model ResidentApplication {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  relationship ResidentRelationship
  status ApplicationStatus @default(PENDING)
  reason String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  decidedBy String?
  @@index([societyId, status, createdAt, id])
  @@index([userId, createdAt, id])
  @@schema("portl_registry")
}
model RegistryAudit {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  actorId String
  action String
  resourceId String
  requestId String
  createdAt DateTime @default(now())
  @@index([societyId, createdAt])
  @@schema("portl_registry")
}

model Gate {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  assignments GuardAssignment[]
  requests VisitorRequest[]
  events MovementEvent[]
  @@unique([societyId, id])
  @@unique([societyId, name])
  @@schema("portl_registry")
}
model GuardAssignment {
  id String @id @default(uuid())
  societyId String
  gateId String
  gate Gate @relation(fields: [societyId, gateId], references: [societyId, id])
  userId String
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  @@unique([societyId, gateId, userId])
  @@index([societyId, userId, active])
  @@schema("portl_registry")
}
enum VisitorCategory {
  GUEST
  DELIVERY
  CAB
  SERVICE
  @@schema("portl_gate")
}
enum VisitorStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  @@schema("portl_gate")
}
enum MovementType {
  ENTRY
  EXIT
  @@schema("portl_gate")
}
model VisitorRequest {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  gateId String
  gate Gate @relation(fields: [societyId, gateId], references: [societyId, id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  visitorName String
  category VisitorCategory
  company String?
  status VisitorStatus @default(PENDING)
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  approvedUntil DateTime?
  decidedBy String?
  decidedAt DateTime?
  recipients RequestRecipient[]
  visit Visit?
  @@unique([societyId, id])
  @@index([societyId, createdAt, id])
  @@index([societyId, status, expiresAt])
  @@schema("portl_gate")
}
model RequestRecipient {
  id String @id @default(uuid())
  societyId String
  requestId String
  request VisitorRequest @relation(fields: [societyId, requestId], references: [societyId, id])
  userId String
  occupancyId String
  occupancyStartedAt DateTime
  createdAt DateTime @default(now())
  @@unique([requestId, userId])
  @@index([societyId, userId, requestId])
  @@schema("portl_gate")
}
model Visit {
  id String @id @default(uuid())
  societyId String
  requestId String @unique
  request VisitorRequest @relation(fields: [societyId, requestId], references: [societyId, id])
  enteredAt DateTime
  enteredBy String
  exitedAt DateTime?
  exitedBy String?
  events MovementEvent[]
  @@unique([societyId, id])
  @@unique([societyId, requestId])
  @@schema("portl_gate")
}
model MovementEvent {
  id String @id @default(uuid())
  societyId String
  visitId String
  visit Visit @relation(fields: [societyId, visitId], references: [societyId, id])
  type MovementType
  gateId String
  gate Gate @relation(fields: [societyId, gateId], references: [societyId, id])
  actorId String
  createdAt DateTime @default(now())
  @@unique([visitId, type])
  @@index([societyId, createdAt])
  @@schema("portl_gate")
}
model GateCommandReceipt {
  societyId String
  actorId String
  intentId String
  inputHash String
  requestId String
  version Int
  createdAt DateTime @default(now())
  @@id([societyId, actorId, intentId])
  @@schema("portl_gate")
}
