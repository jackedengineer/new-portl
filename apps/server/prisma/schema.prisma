generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["portl_auth", "portl_registry", "portl_gate", "portl_notifications", "portl_community"]
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  twoFactorEnabled Boolean @default(false)
  policy AccountPolicy?
  deletionRequestedAt DateTime?
  deletionChallenges DeletionChallenge[]
  guardAssignments GuardAssignment[]
  requestRecipients RequestRecipient[]
  twoFactor TwoFactor?
  totpUses AdminTotpUse[]
  notifications Notification[]
  memberships Membership[]
  occupancies Occupancy[]
  applications ResidentApplication[]
  sessions      Session[]
  accounts      Account[]

  @@schema("portl_auth")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  assurance AdminAssurance?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("portl_auth")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@schema("portl_auth")
}

model Verification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@schema("portl_auth")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@schema("portl_auth")
}

model OtpThrottle {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@schema("portl_auth")
}

model TwoFactor {
  id String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  @@schema("portl_auth")
}
model AdminAssurance {
  sessionId String @id
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@schema("portl_auth")
}
model AdminTotpUse {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  digest String
  expiresAt DateTime
  @@id([userId, digest])
  @@schema("portl_auth")
}
enum SocietyRole {
  RESIDENT
  GUARD
  ADMIN
  @@schema("portl_registry")
}
enum ResidentRelationship {
  OWNER
  TENANT
  @@schema("portl_registry")
}
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  @@schema("portl_registry")
}
model Society {
  directory DirectoryEntry[]
  id String @id @default(uuid())
  name String
  joinCodeHash String @unique
  isDemo Boolean @default(true)
  archived Boolean @default(false)
  towers Tower[]
  flats Flat[]
  memberships Membership[]
  occupancies Occupancy[]
  invitations Invitation[]
  applications ResidentApplication[]
  audits RegistryAudit[]
  gates Gate[]
  guestPasses GuestPass[]
  visitorRequests VisitorRequest[]
  @@schema("portl_registry")
  notifications Notification[]
  notices Notice[]
}
model Tower {
  archived Boolean @default(false)
  version Int @default(1)
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  name String
  flats Flat[]
  @@unique([societyId, id])
  @@unique([societyId, name])
  @@schema("portl_registry")
}
model Flat {
  version Int @default(1)
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  towerId String
  tower Tower @relation(fields: [societyId, towerId], references: [societyId, id])
  label String
  archived Boolean @default(false)
  occupancies Occupancy[]
  invitations Invitation[]
  applications ResidentApplication[]
  guestPasses GuestPass[]
  visitorRequests VisitorRequest[]
  @@unique([societyId, id])
  @@unique([societyId, towerId, label])
  @@schema("portl_registry")
}
model Membership {
  grantVersion Int @default(1)
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SocietyRole
  active Boolean @default(true)
  @@unique([societyId, userId, role])
  @@index([userId, active])
  @@schema("portl_registry")
}
model Occupancy {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestPasses GuestPass[]
  relationship ResidentRelationship
  startedAt DateTime @default(now())
  endedAt DateTime?
  @@unique([societyId, id])
  @@unique([societyId, flatId, userId])
  @@index([userId, endedAt])
  @@schema("portl_registry")
}
model Invitation {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  email String
  relationship ResidentRelationship
  tokenHash String @unique
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  acceptedBy String?
  revokedAt DateTime?
  @@index([societyId, createdAt, id])
  @@schema("portl_registry")
}
model ResidentApplication {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  relationship ResidentRelationship
  status ApplicationStatus @default(PENDING)
  reason String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  decidedBy String?
  @@index([societyId, status, createdAt, id])
  @@index([userId, createdAt, id])
  @@schema("portl_registry")
}
model RegistryAudit {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  actorId String
  action String
  resourceId String
  requestId String
  createdAt DateTime @default(now())
  @@index([societyId, createdAt])
  @@schema("portl_registry")
}

model DirectoryEntry {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  name String
  kind String
  service String
  description String @default("")
  archived Boolean @default(false)
  version Int @default(1)
  contact DirectoryContact?
  @@unique([societyId, id])
  @@index([societyId, archived, id])
  @@schema("portl_registry")
}
model DirectoryContact {
  entryId String @id
  societyId String
  entry DirectoryEntry @relation(fields: [societyId, entryId], references: [societyId, id], onDelete: Cascade)
  phone String?
  sharePhone Boolean @default(false)
  @@unique([societyId, entryId])
  @@schema("portl_registry")
}

model Gate {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  assignments GuardAssignment[]
  requests VisitorRequest[]
  events MovementEvent[]
  @@unique([societyId, id])
  @@unique([societyId, name])
  @@schema("portl_registry")
}
model GuardAssignment {
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  grantVersion Int @default(1)
  id String @id @default(uuid())
  societyId String
  gateId String
  gate Gate @relation(fields: [societyId, gateId], references: [societyId, id])
  userId String
  active Boolean @default(true)
  createdBy String
  createdAt DateTime @default(now())
  @@unique([societyId, gateId, userId])
  @@index([societyId, userId, active])
  @@schema("portl_registry")
}
enum VisitorCategory {
  GUEST
  DELIVERY
  CAB
  SERVICE
  @@schema("portl_gate")
}
enum VisitorStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  @@schema("portl_gate")
}
enum MovementType {
  ENTRY
  EXIT
  @@schema("portl_gate")
}
model VisitorRequest {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  gateId String
  gate Gate @relation(fields: [societyId, gateId], references: [societyId, id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  visitorName String
  category VisitorCategory
  company String?
  status VisitorStatus @default(PENDING)
  version Int @default(1)
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  approvedUntil DateTime?
  decidedBy String?
  decidedAt DateTime?
  recipients RequestRecipient[]
  visit Visit?
  @@unique([societyId, id])
  @@index([societyId, createdAt, id])
  @@index([societyId, status, expiresAt])
  @@schema("portl_gate")
}
model RequestRecipient {
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  id String @id @default(uuid())
  societyId String
  requestId String
  request VisitorRequest @relation(fields: [societyId, requestId], references: [societyId, id])
  userId String
  occupancyId String
  occupancyStartedAt DateTime
  createdAt DateTime @default(now())
  @@unique([requestId, userId])
  @@index([societyId, userId, requestId])
  @@schema("portl_gate")
}
model Visit {
  id String @id @default(uuid())
  societyId String
  passId String? @unique
  pass GuestPass? @relation(fields: [societyId, passId], references: [societyId, id])
  requestId String? @unique
  request VisitorRequest? @relation(fields: [societyId, requestId], references: [societyId, id])
  enteredAt DateTime
  enteredBy String
  exitedAt DateTime?
  exitedBy String?
  events MovementEvent[]
  @@unique([societyId, id])
  @@unique([societyId, requestId])
  @@unique([societyId, passId])
  @@schema("portl_gate")
}
model MovementEvent {
  id String @id @default(uuid())
  societyId String
  visitId String
  visit Visit @relation(fields: [societyId, visitId], references: [societyId, id])
  type MovementType
  gateId String
  gate Gate @relation(fields: [societyId, gateId], references: [societyId, id])
  actorId String
  createdAt DateTime @default(now())
  @@unique([visitId, type])
  @@index([societyId, createdAt])
  @@schema("portl_gate")
}
model GateCommandReceipt {
  societyId String
  actorId String
  intentId String
  inputHash String
  resourceId String
  resourceKind String @default("REQUEST")
  version Int
  createdAt DateTime @default(now())
  @@id([societyId, actorId, intentId])
  @@schema("portl_gate")
}

model GuestPass {
  id String @id @default(uuid())
  societyId String
  society Society @relation(fields: [societyId], references: [id])
  flatId String
  flat Flat @relation(fields: [societyId, flatId], references: [societyId, id])
  issuerId String
  occupancyId String
  occupancy Occupancy @relation(fields: [societyId, occupancyId], references: [societyId, id])
  occupancyStartedAt DateTime
  visitorName String
  tokenHash String @unique
  cipherText String
  createdAt DateTime @default(now())
  validFrom DateTime
  validUntil DateTime
  revokedAt DateTime?
  version Int @default(1)
  visit Visit?
  @@unique([societyId, id])
  @@index([societyId, createdAt, id])
  @@index([societyId, issuerId, validUntil])
  @@schema("portl_gate")
}

model Notification {
 id String @id
 societyId String
 society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 type String
 resourceKind String
 resourceId String
 version Int
 membershipId String
 membershipVersion Int
 view String
 flatId String?
 occupancyId String?
 occupancyStartedAt DateTime?
 assignmentId String?
 assignmentVersion Int?
 gateId String?
 createdAt DateTime @default(now())
 readAt DateTime?
 expiresAt DateTime
 pushEligible Boolean @default(true)
 deliveries Delivery[]
 @@unique([societyId, userId, type, resourceId, version])
 @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "notification_inbox")
 @@schema("portl_notifications")
}
model PushDevice {
 id String @id
 userId String
 sessionId String
 generation String
 platform String
 tokenHash String @unique
 cipherText String
 enabled Boolean @default(true)
 updatedAt DateTime @default(now())
 @@index([userId], map: "device_user")
 @@schema("portl_notifications")
}
model Delivery {
 id String @id
 notificationId String
 notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
 deviceId String
 generation String
 status String @default("PENDING")
 ticketId String?
 errorCode String?
 createdAt DateTime @default(now())
 @@unique([notificationId, deviceId, generation])
 @@schema("portl_notifications")
}

model Notice {
 id String @id
 societyId String
 society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
 title String
 body String
 status String @default("DRAFT")
 version Int @default(1)
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @default(now())
 publishedAt DateTime?
 archivedAt DateTime?
 publication NoticePublication?
 @@index([societyId, status, createdAt(sort: Desc), id(sort: Desc)], map: "notice_board")
 @@schema("portl_community")
}
model NoticePublication {
 noticeId String @id
 notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
 capturedAt DateTime @default(now())
 @@schema("portl_community")
}

model AccountPolicy {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version String
  adult Boolean
  acceptedAt DateTime @default(now())
  @@schema("portl_auth")
}
model DeletionChallenge {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  digest String
  receiptHash String @unique
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
  @@schema("portl_auth")
}
model AccountDeletion {
  id String @id
  userId String? @unique
  subjectHash String
  emailHash String?
  receiptHash String @unique
  status String @default("PENDING")
  requestedAt DateTime @default(now())
  completedAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@schema("portl_auth")
}
