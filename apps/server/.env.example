# API startup validates the active bootstrap, auth, database and email fields.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# 0 for direct/local traffic; 1 only for verified Render HTTP ingress.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Active database + email OTP integration.
# Use one Neon DEVELOPMENT branch with separate runtime and migration roles.
# Runtime: pooled connection, restricted role (no BYPASSRLS / table ownership).
DATABASE_URL=
# Migrations only: direct connection, schema-management role; not a mobile secret.
DIRECT_DATABASE_URL=

# Generate locally; keep distinct values for development, staging and production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Exact allowed app origins. No wildcard in production.
TRUSTED_ORIGINS=portl://

# Sending-only API key for the verified jacked.dev domain.
RESEND_API_KEY=
EMAIL_FROM="Portl <auth@jacked.dev>"

# Notifications: dedicated restricted worker login on the SAME database.
# Local db:provision creates this after db:migrate and db:jobs:init.
WORKER_DATABASE_URL=

# Later: private attachments; scope credentials to the Portl environment bucket.
AWS_REGION=
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional diagnostics; enable enhanced push security in EAS when setting EXPO_ACCESS_TOKEN.
SENTRY_DSN=
EXPO_ACCESS_TOKEN=

# Production worker: absolute path to a mode-0700 directory on a durable private volume.
# Create an empty private directory only for a fresh deployment; preserve it across DB restores.
# Development default: apps/server/.private/account-deletions (ignored).
ACCOUNT_DELETION_LEDGER_DIR=
# Alternative durable store in an independent Neon project. Set only one ledger option.
ERASURE_LEDGER_DATABASE_URL=
