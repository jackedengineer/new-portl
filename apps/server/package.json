{
  "name": "@portl/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/api.ts",
    "start:api": "node --env-file-if-exists=.env dist/api.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint src scripts prisma.config.ts vitest.config.ts vitest.integration.config.ts",
    "test": "vitest",
    "test:integration": "tsx --env-file-if-exists=.env scripts/test-integration.ts",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:provision": "tsx --env-file=.env scripts/provision-runtime.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "db:jobs:init": "tsx --env-file-if-exists=.env scripts/init-jobs.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "db:recovery": "tsx --env-file-if-exists=.env scripts/recovery.ts",
    "db:reviewer": "tsx --env-file-if-exists=.env scripts/reviewer.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@portl/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pg-boss": "12.35.0",
    "pino": "10.4.0",
    "resend": "6.32.1",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
