{
  "name": "portl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev:api": "pnpm --filter @portl/server dev:api",
    "dev:mobile": "pnpm --filter @portl/mobile start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @portl/server test --run",
    "build:server": "pnpm --filter @portl/server build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
